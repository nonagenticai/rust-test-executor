{
  "name": "rust-test-executor",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "CI manifest for rust-test-executor: runs eslint + jest unit tests via the ts-service archetype. The shipped service lives in src/ and is built by the Dockerfile.",
