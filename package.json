  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "express-rate-limit": "^8.7.4",
    "fast-xml-parser": "^5.11.2",
    "jest": "^30.3.0",
    "supertest": "^7.3.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0"
}
